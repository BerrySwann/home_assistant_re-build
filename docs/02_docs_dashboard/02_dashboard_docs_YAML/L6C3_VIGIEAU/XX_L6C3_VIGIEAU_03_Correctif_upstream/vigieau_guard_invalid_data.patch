@@ -455,6 +460,7 @@ class AlertLevelEntity(CoordinatorEntity, SensorEntity):
         self._attr_native_value = None
         legacy_name = self.build_name()
         self._attr_state_attributes = None
+        self._data_unavailable = False
         if MIGRATED_FROM_VERSION_1 in config_entry.data:
             self._attr_unique_id = "sensor-vigieau-Alert level"
         elif MIGRATED_FROM_VERSION_5 in config_entry.data:
@@ -508,13 +514,49 @@ class AlertLevelEntity(CoordinatorEntity, SensorEntity):
             data = self.coordinator.location()
         return {"city": data.get(CONF_CITY)}
 
+    def _notification_id(self) -> str:
+        return f"vigieau_data_unavailable_{self._config_entry.entry_id}"
+
+    def _handle_unavailable_data(self, reason: str) -> None:
+        """VigiEau data is unusable: expose a safe default and tell the user."""
+        if not self._data_unavailable:
+            _LOGGER.warning(
+                f"VigiEau data is unavailable ({reason}). "
+                f"The numeric alert level falls back to {self.FALLBACK_NUMERIC_VALUE} until data is back"
+            )
+            persistent_notification.async_create(
+                self.hass,
+                "VigiEau data is currently unavailable (the API returned an error or an unusable answer). "
+                f"The numeric alert level shows {self.FALLBACK_NUMERIC_VALUE} by default, "
+                "which does NOT mean there is no restriction. "
+                "This message disappears automatically when data is back.",
+                title="VigiEau: data unavailable",
+                notification_id=self._notification_id(),
+            )
+        self._data_unavailable = True
+        self._attr_state_attributes = self._attr_state_attributes or {}
+        self._attr_state_attributes["data_available"] = False
+        self._attr_state_attributes["data_unavailable_reason"] = reason
+        if self._numeric_state:
+            self._attr_native_value = self.FALLBACK_NUMERIC_VALUE
+        self.async_write_ha_state()
+
     @callback
     def _handle_coordinator_update(self) -> None:
         _LOGGER.debug(f"Receiving an update for {self.unique_id} sensor")
         if not self.coordinator.last_update_success:
-            _LOGGER.debug(
-                "Last coordinator failed, assuming state has not changed")
+            self._handle_unavailable_data(
+                f"last update failed: {self.coordinator.last_exception}")
+            return
+        data = self.coordinator.data
+        if not isinstance(data, dict) or data.get("_numeric_state_value") not in LEVEL_COLORS:
+            self._handle_unavailable_data("invalid or incomplete data received")
             return
+        if self._data_unavailable:
+            self._data_unavailable = False
+            persistent_notification.async_dismiss(
+                self.hass, self._notification_id())
+            _LOGGER.info("VigiEau data is available again")
         self._attr_translation_placeholders = self._build_translation_placeholders()
         self._attr_device_info = self.build_device()
         self.numeric_state_value = self.coordinator.data["_numeric_state_value"]
@@ -545,6 +587,8 @@ class AlertLevelEntity(CoordinatorEntity, SensorEntity):
         self._attr_state_attributes["current_restrictions"] = ", ".join(
             restrictions)
         self._attr_state_attributes["Couleur"] = LEVEL_COLORS[self.numeric_state_value]
+        self._attr_state_attributes["data_available"] = True
+        self._attr_state_attributes.pop("data_unavailable_reason", None)
 
         self.async_write_ha_state()
 
