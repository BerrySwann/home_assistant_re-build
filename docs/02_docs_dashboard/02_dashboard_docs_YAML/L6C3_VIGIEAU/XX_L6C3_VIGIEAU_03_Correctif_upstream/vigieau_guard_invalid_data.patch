@@ -438,6 +439,10 @@ def extract_time_range(restrictions):
 class AlertLevelEntity(CoordinatorEntity, SensorEntity):
     """Expose the alert level for the location"""
 
+    # Value exposed by the numeric sensor when VigiEau data is unusable
+    # (API down, None / unknown / malformed answer).
+    FALLBACK_NUMERIC_VALUE = 0
+
     def __init__(
         self,
