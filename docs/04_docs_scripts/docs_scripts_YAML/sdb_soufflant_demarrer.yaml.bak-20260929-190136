# ╭──────────────────────────────────────────────────────────────────────────────╮
# │ SDB - SOUFFLANT : SEQUENCE DE DEMARRAGE
# ╰──────────────────────────────────────────────────────────────────────────────╯
#
# ## DESCRIPTION :
# Prise ON, mise en route IR, deux impulsions 1000 W pour atteindre 2000 W,
# puis verrou de deux minutes qui bloque la marche comme l'arret.
#
# ## CHAINE DE DEPENDANCES :
#
# | MATERIEL      | SOURCE                            | CE FICHIER            | AVAL                     |
# |:--------------|:----------------------------------|:----------------------|:-------------------------|
# | [virtuel/UI]  | automation SDB - SOUFFLANT - ROUTAGE
#
# ## ETAT :
# - Deploye en prod le 2026-09-28 dans scripts.yaml, recharge sans redemarrage.
#
# --- version finale 2026/2027 du soufflant salle de bain ---

sdb_soufflant_demarrer:
  alias: "SDB - Soufflant : DEMARRAGE (2000 W, verrou 2 min)"
  description: '[EXECUTANT] Prise ON, mise en route IR, 2 impulsions 1000 W, verrou 2 min.'
  mode: single
  sequence:
    - alias: "Attendre la fin d'une sequence d'arret en cours"
      wait_template: "{{ is_state('script.sdb_soufflant_arreter', 'off') }}"
      timeout: "00:02:00"
    - alias: "POSER LE VERROU (2 minutes)"
      action: input_boolean.turn_on
      target:
        entity_id: input_boolean.verrou_soufflant_salle_de_bain
    - alias: "Alimenter la prise"
      action: switch.turn_on
      target:
        entity_id: switch.prise_soufflant_salle_de_bain_nous
    - delay: "00:00:01"
    - alias: "Mise en route de l'appareil (IR)"
      action: remote.send_command
      target:
        entity_id: remote.soufflant_sdb
      data:
        command: on_off
        device: radiateur_sdb
    - delay: "00:00:00.8"
    - alias: "Deux impulsions 1000 W, soit 2000 W"
      action: remote.send_command
      target:
        entity_id: remote.soufflant_sdb
      data:
        command: 1000w
        device: radiateur_sdb
        num_repeats: 2
        delay_secs: 0.8
    - alias: "Compteur d'etat logiciel"
      action: input_select.select_option
      target:
        entity_id: input_select.etat_resistance_soufflant_sdb
      data:
        option: 2000W
    - alias: "VERROU : deux minutes de marche protegee"
      delay: "00:02:00"
    - alias: "LEVER LE VERROU"
      action: input_boolean.turn_off
      target:
        entity_id: input_boolean.verrou_soufflant_salle_de_bain
    - alias: "Si l'interrupteur a ete remis sur OFF pendant le verrou, arreter"
      choose:
        - conditions:
            - condition: state
              entity_id: input_boolean.inter_soufflant_salle_de_bain
              state: "off"
          sequence:
            - action: script.turn_on
              target:
                entity_id: script.sdb_soufflant_arreter

