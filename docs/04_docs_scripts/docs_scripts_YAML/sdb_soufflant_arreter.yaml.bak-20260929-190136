# ╭──────────────────────────────────────────────────────────────────────────────╮
# │ SDB - SOUFFLANT : SEQUENCE D'ARRET
# ╰──────────────────────────────────────────────────────────────────────────────╯
#
# ## DESCRIPTION :
# Coupure des deux resistances, ventilateur une minute trente pour les
# refroidir, puis coupure de la prise pour ne pas payer les 4 W de veille.
# Refuse de s'executer pendant le verrou de demarrage.
#
# ## CHAINE DE DEPENDANCES :
#
# | MATERIEL      | SOURCE                            | CE FICHIER            | AVAL                     |
# |:--------------|:----------------------------------|:----------------------|:-------------------------|
# | [virtuel/UI]  | automation SDB - SOUFFLANT - ROUTAGE
#
# ## ETAT :
# - Deploye en prod le 2026-09-28 dans scripts.yaml, recharge sans redemarrage.
#
# --- version finale 2026/2027 du soufflant salle de bain ---

sdb_soufflant_arreter:
  alias: "SDB - Soufflant : ARRET (resistances, ventilateur 1 min 30, prise)"
  description: "[EXECUTANT] Coupure resistances, refroidissement 1 min 30, coupure prise."
  mode: single
  sequence:
    - alias: "REFUS si le verrou de demarrage est actif"
      condition: state
      entity_id: input_boolean.verrou_soufflant_salle_de_bain
      state: "off"
    - alias: "Coupure des deux resistances (le ventilateur continue)"
      action: remote.send_command
      target:
        entity_id: remote.soufflant_sdb
      data:
        command: on_off
        device: radiateur_sdb
    - alias: "Compteur d'etat logiciel"
      action: input_select.select_option
      target:
        entity_id: input_select.etat_resistance_soufflant_sdb
      data:
        option: 0W
    - alias: "Refroidissement des resistances par le ventilateur"
      delay: "00:01:30"
    - alias: "Dernier controle : ne pas couper si l'appareil a ete rallume"
      condition: state
      entity_id: input_boolean.inter_soufflant_salle_de_bain
      state: "off"
    - alias: "Coupure de la prise (4 W de veille)"
      action: switch.turn_off
      target:
        entity_id: switch.prise_soufflant_salle_de_bain_nous

